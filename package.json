{
  "name": "dox-web",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:execution": "node scripts/audit-execution.mjs",
    "audit:execution:reducer": "node scripts/audit-execution-reducer.mjs",
    "check:execution": "dune runtest src/test_execution_contract.exe && node scripts/check-execution-corpus.mjs",
    "build:web": "esbuild web/editor-source.js --bundle --format=esm --minify --outfile=web/editor.bundle.js",
    "check:web": "npm run build:web && node --check web/app.js && node --test web/*.test.mjs collaboration/*.test.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "esbuild": "^0.25.5"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "lib0": "^0.2.114",
    "node-diff3": "^3.2.1",
    "ws": "^8.21.1",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  }
}
