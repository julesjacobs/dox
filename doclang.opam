opam-version: "2.0"
synopsis: "A live literate OCaml workspace"
description: """
Doclang combines Markdown documents, ordinary OCaml compilation units, live
runtime views, versioned project snapshots, and reviewable change sets.
"""
maintainer: "Doclang contributors"
authors: "Doclang contributors"
license: "MIT"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.15"}
  "yojson" {>= "3.0"}
  "merlin" {>= "5.0"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
